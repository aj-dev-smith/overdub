# Copy to deploy/.env (gitignored) and fill in. deploy/setup.sh and deploy/relay/*.sh read it.
ZONE=          # the Route53 hosted zone id for your domain
CERT=          # an ACM certificate ARN in us-east-1 covering the site's and the relay's names
OAC=           # a CloudFront origin access control id (setup.sh's distribution reads the bucket through it)
