# Copy to deploy/.env (gitignored) and fill in. deploy/setup.sh and deploy/relay/*.sh read it.
ZONE=          # the Route53 hosted zone id for your domain
CERT=          # an ACM certificate ARN in us-east-1 covering the site's and the relay's names
OAC=           # a CloudFront origin access control id (setup.sh's distribution reads the bucket through it)
# The preview site (deploy/next/setup.sh). All optional: each is looked up (or made) when blank.
NEXT_ZONE=     # the overdubstudio.com hosted zone id (else looked up by name)
NEXT_OAC=      # an origin access control id for the preview (else OAC above, else one named overdub-next)
NEXT_CERT=     # an ACM certificate ARN for next.overdubstudio.com (else found or requested and validated by DNS)
