{
  "id": "write-drum-groove",
  "family": "writing",
  "title": "Verse beat",
  "instruction": "The verse (bars 1-4) has no drums. On the Kit track, write a beat: kick on beats 1 and 3, snare or clap on 2 and 4, eighth-note hi-hats, and make bar 4 a fill that's different from bar 1.",
  "song": "songs/night-shift.json",
  "setup": [{ "type": "track.remove", "track": "Kick" }, { "type": "notes.replace", "track": "Kit", "clip": "c_kit001", "notes": "" }],
  "checks": [
    { "id": "kick", "label": "Kicks on beats 1 and 3, bars 1-4", "kind": "pattern",
      "sel": { "tracks": ["Kit"], "pitches": [35, 36] }, "at": [0, 2], "bars": [0, 4], "target": [1, 1], "soft": 0.75, "weight": 2 },
    { "id": "backbeat", "label": "Snare or clap on beats 2 and 4, bars 1-4", "kind": "pattern",
      "sel": { "tracks": ["Kit"], "pitches": [37, 38, 39, 40] }, "at": [1, 3], "bars": [0, 4], "target": [1, 1], "soft": 0.75, "weight": 2 },
    { "id": "hats", "label": "Hats on every eighth, bars 1-3", "kind": "pattern",
      "sel": { "tracks": ["Kit"], "pitches": [42, 44, 46] }, "at": [0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5], "bars": [0, 3], "target": [1, 1], "soft": 0.75, "weight": 2 },
    { "id": "fill", "label": "Bar 4 differs from bar 1", "kind": "differs",
      "sel": { "tracks": ["Kit"] }, "a": 0, "b": 3, "target": [1, 1], "weight": 1 },
    { "id": "heard", "label": "Kit loudness in the verse", "kind": "measure", "metric": "lufs", "unit": "LUFS",
      "scope": { "tracks": ["Kit"], "section": "Verse" }, "target": [-30, null], "soft": 10, "weight": 1 },
    { "id": "others", "label": "Bass, keys and hook notes as they were", "kind": "unchanged",
      "sel": { "tracks": ["Bass", "Keys", "Hook"] }, "target": [1, 1], "soft": 0.5, "gate": true }
  ]
}
