{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["app/src/**/*.js"],
  "exclude": ["app/vendor"]
}
